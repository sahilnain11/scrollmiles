{
  "name": "scrollmiles",
  "description": "Your digital life, measured. A local-first scrolling tracker.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.21.2",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=11.21.2"
  },
  "scripts": {
    "assets": "node scripts/generate-icons.mjs",
    "predev": "npm run assets",
    "dev": "wxt",
    "prebuild": "npm run assets",
    "build": "wxt build",
    "prezip": "npm run assets",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/chrome": "^0.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@wxt-dev/module-react": "^1.2.2",
    "fake-indexeddb": "^6.0.0",
    "happy-dom": "^21.0.4",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0",
    "wxt": "^0.21.5"
  }
}
